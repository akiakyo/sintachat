generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ConsentAcceptance {
  id                 String   @id @default(uuid()) @db.Uuid
  anonymousSessionId String?  @db.Uuid
  termsAccepted      Boolean  @default(false)
  ageConfirmed       Boolean  @default(false)
  locationConfirmed  Boolean  @default(false)
  termsVersion       String   @db.VarChar(32)
  safetyVersion      String   @db.VarChar(32)
  privacyVersion     String   @db.VarChar(32)
  acceptedAt         DateTime @default(now()) @db.Timestamptz(3)

  @@index([anonymousSessionId])
  @@index([acceptedAt])
  @@map("consent_acceptances")
}

model anonymous_sessions {
  id           BigInt       @id @default(autoincrement())
  session_uuid String       @unique @db.Uuid
  nickname     String       @db.VarChar(24)
  gender       String?
  campus       String       @db.VarChar(100)
  preference   String       @default("anyone")
  status       String       @default("waiting")
  last_seen_at DateTime     @default(now()) @db.Timestamptz(6)
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  match_queue  match_queue?

  @@index([last_seen_at], map: "idx_sessions_last_seen")
}

model blocks {
  id           BigInt   @id @default(autoincrement())
  blocker_uuid String   @db.Uuid
  blocked_uuid String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@unique([blocker_uuid, blocked_uuid])
}

model match_queue {
  id                 BigInt             @id @default(autoincrement())
  session_uuid       String             @unique @db.Uuid
  preference         String?            @default("anyone")
  status             String             @default("waiting")
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  anonymous_sessions anonymous_sessions @relation(fields: [session_uuid], references: [session_uuid], onDelete: Cascade, onUpdate: NoAction, map: "fk_match_queue_session")
}

model matches {
  id         BigInt   @id @default(autoincrement())
  match_uuid String   @unique @db.Uuid
  user_a     String   @db.Uuid
  user_b     String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_matches_created")
}

model messages {
  id          BigInt   @id @default(autoincrement())
  match_uuid  String   @db.Uuid
  sender_uuid String   @db.Uuid
  content     String   @db.VarChar(1000)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([match_uuid, created_at], map: "idx_messages_match")
}

model reports {
  id            BigInt   @id @default(autoincrement())
  reporter_uuid String   @db.Uuid
  reported_uuid String?  @db.Uuid
  match_uuid    String?  @db.Uuid
  reason        String
  details       String?  @db.VarChar(500)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
}

enum Gender {
  male
  female
  unspecified
}

enum MatchPreference {
  anyone
  male
  female
}

enum ReportReason {
  harassment
  sexual_content
  spam
  hate
  personal_info
  other
}
